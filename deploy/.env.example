# Domain the site is served on; its A/AAAA record must point to this server.
ATID_DOMAIN=atid.example.com
# Prebuilt images published by .github/workflows/images.yml
ATID_IMAGE_REPO=ghcr.io/mhdolatabadi/atid
# Docker network of the reverse proxy (Caddy) that owns ports 80/443 on the server.
# nafir's stack creates it as deploy_edge; check with: docker network ls
ATID_PROXY_NETWORK=deploy_edge
