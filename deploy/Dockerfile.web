FROM node:22-alpine AS build

WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
# Public address of the site, for canonical URLs and sitemap.xml (e.g. https://atid.example.com).
ARG SITE_URL=
RUN test -n "$SITE_URL" || (echo "SITE_URL must be set to the public HTTPS origin." >&2; exit 1)
RUN SITE_URL="$SITE_URL" npm run build

FROM nginx:1.27-alpine
# The official nginx entrypoint renders this template at container startup.  The
# revision header lets the deployment check prove that the public proxy reaches
# the image it just started, rather than merely returning any HTTP 200 response.
ARG ATID_REVISION=unknown
ENV ATID_REVISION=$ATID_REVISION
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
